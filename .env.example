# Web UI Backend Environment Configuration
#
# Quick setup: run `make refresh-token` to populate DEV_ACCESS_TOKEN automatically.
# See README.md for prerequisites (kubeconfig + kubectl-oidc-login plugin).

# Development Authentication
# Set automatically by `make refresh-token`. Tokens expire — re-run if you get 401s.
DEV_ACCESS_TOKEN=

# Server Configuration
PORT=8090
NODE_ENV=development

# Kubernetes Configuration
NAMESPACE=default
STATIC_DIR=./dist

# Namespace selection (multi-namespace). Zero-config = single `NAMESPACE`.
# Static candidate list (no RBAC needed); used as the fallback when the SA can't list.
# In dev (no cluster) this IS the switcher's namespace set - set it to exercise the UI.
# WORKSPACE_NAMESPACES=team-alice,team-bravo
# Label key marking discoverable namespaces (sa-list mode). Default shown.
# WORKSPACE_NAMESPACE_LABEL=workspace.jupyter.org/workspaces-enabled
# NAMESPACE_CANDIDATE_CAP=20            # SSAR fan-out page size (candidates checked per page)
# NAMESPACE_VISIBLE_PERSIST_CAP=100     # max visible namespaces stored in the cookie (rest served live)
# NAMESPACE_POLL_INTERVAL_SECS=60

# Optional: Override the username extracted from the JWT token
# Format: "github:username" or "email:user@example.com"
# Leave empty to use the username from the token
DEV_USER=
